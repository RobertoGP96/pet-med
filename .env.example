# ---------------------------------------------------------------------------
# Copia este archivo a `.env.local` y rellena los valores.
#   cp .env.example .env.local
# `.env.local` está en .gitignore: nunca subas claves reales al repositorio.
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# Panel de Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"

# Clave pública (publishable / anon). Se expone al navegador: es segura
# siempre que las políticas RLS estén activas.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Clave secreta (service_role). NUNCA la expongas al cliente: sólo se lee
# desde código de servidor. Salta RLS, por eso la app la usa mientras no
# exista autenticación de usuarios.
SUPABASE_SECRET_KEY=""

# --- Identidad temporal -----------------------------------------------------
# Mientras no haya login, todas las mascotas se crean con este `owner_id`.
# Debe ser un UUID válido. Cuando se añada auth, se sustituye por el id de
# sesión y esta variable desaparece.
APP_DEFAULT_OWNER_ID="00000000-0000-0000-0000-000000000001"

# --- Almacenamiento de fotos ------------------------------------------------
# "local"    -> guarda los archivos en public/uploads (por defecto, sin setup)
# "supabase" -> sube a Supabase Storage (requiere el bucket STORAGE_BUCKET)
STORAGE_DRIVER="local"
STORAGE_BUCKET="pet-photos"

# --- APIs públicas de razas -------------------------------------------------
# Los datos de PERROS vienen de dogapi.dog y los de FOTOS de dog.ceo: ninguna
# de las dos usa clave, así que no hay nada que configurar.
#
# Los de GATOS vienen de The Cat API, que responde igual sin clave pero con un
# límite de peticiones más bajo. Clave gratuita en https://thecatapi.com
CAT_API_KEY=""
